# Large binary files go through Git LFS. "lockable" lets one person lock a file while editing it.
*.wbpz   filter=lfs diff=lfs merge=lfs -text lockable
*.SLDPRT filter=lfs diff=lfs merge=lfs -text lockable
*.sldprt filter=lfs diff=lfs merge=lfs -text lockable
*.SLDASM filter=lfs diff=lfs merge=lfs -text lockable
*.sldasm filter=lfs diff=lfs merge=lfs -text lockable
*.step   filter=lfs diff=lfs merge=lfs -text
*.stp    filter=lfs diff=lfs merge=lfs -text
*.pdf    filter=lfs diff=lfs merge=lfs -text
*.pptx   filter=lfs diff=lfs merge=lfs -text lockable
*.docx   filter=lfs diff=lfs merge=lfs -text lockable

# Text files: keep line endings consistent between Windows and Linux
*.py    text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.wbjn  text eol=crlf
